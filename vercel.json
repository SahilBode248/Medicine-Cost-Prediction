{
  "functions": {
    "api/index.py": {
      "memory": 1024,
      "maxDuration": 15
    },
    "api/predict.py": {
      "memory": 1024,
      "maxDuration": 15
    },
    "api/metadata.py": {
      "memory": 256,
      "maxDuration": 10
    }
  },
  "rewrites": [
    { "source": "/api/metadata", "destination": "/api/index.py" },
    { "source": "/api/predict", "destination": "/api/index.py" }
  ]
}
